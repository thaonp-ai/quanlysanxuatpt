{
  // Web tra cứu P&ID (thư mục web/), bắt buộc đăng nhập; tài khoản + chỉnh sửa tag lưu ở Cloudflare KV (worker.js)
  "name": "quanlysanxuatpt",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // KV lưu chỉnh sửa: Wrangler (>= 4.45) tự tạo namespace ở lần deploy đầu nếu chưa có id
  "kv_namespaces": [{ "binding": "EDITS" }],
  // Tài khoản "admin" dựng sẵn: đang TẮT (chuỗi rỗng). Bật lại khi quên mật khẩu quản trị: đặt mã băm PBKDF2 "salt:hash"
  // (16 byte salt, 100000 vòng, SHA-256, 32 byte) của mật khẩu mới. Để rỗng chứ không xóa dòng, vì keep_vars giữ biến cũ.
  "vars": { "ADMIN_HASH": "" },
  // Giữ biến/secret đặt trên dashboard (ADMIN_PASSWORD, SESSION_SECRET) khi deploy lại
  "keep_vars": true
}
