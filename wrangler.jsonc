{
  // Web tra cứu P&ID (thư mục web/), bắt buộc đăng nhập; tài khoản + chỉnh sửa tag lưu ở Cloudflare KV (worker.js)
  "name": "quanlysanxuatpt",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // KV lưu chỉnh sửa: Wrangler (>= 4.45) tự tạo namespace ở lần deploy đầu nếu chưa có id
  "kv_namespaces": [{ "binding": "EDITS" }],
  // Giữ biến/secret đặt trên dashboard (ADMIN_PASSWORD, SESSION_SECRET) khi deploy lại
  "keep_vars": true
}
